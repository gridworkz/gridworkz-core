---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { site } from '../../site';
---
<Base title="NPU register playground" description="Program the GRX930 NPU's registers in your browser: start a GEMM, watch BUSY/DONE/ERROR and the command queue, see the packed memory, and get the matching C driver code.">
  <PageHead eyebrow="Playground · NPU register playground" title="Drive the GRX930 NPU from its registers.">
    Set the dimensions, precision and buffer addresses, then write START. The NPU's register file, status flags,
    command queue and memory update the way the driver's contract says they do, and the C code to do it on the real chip is written for you.
  </PageHead>

  <section style="padding-top:0">
    <div class="wrap">
      <p class="model mono"><span class="st">Model</span> Behavior and data model of <code>c930_npu_csr.sv</code> and <code>c930_npu_driver.c</code>, not the RTL running. Timing is illustrative; read <code>CYCLE_LO</code>, <code>OP_COUNT</code> and <code>STALL_CT</code> from <code>make npu</code> or the board for real cycle counts.</p>
      <div class="pg">
        <!-- 1. Program -->
        <div class="card ctl">
          <h3>1 · Program</h3>
          <div class="fields">
            <label>NPU<select id="npu"><option value="0">NPU0 · 0x4000_0000</option><option value="1">NPU1 · 0x4000_0040</option></select></label>
            <label>DIM_M <small>1–8</small><input id="m" type="number" min="1" max="12" value="4" /></label>
            <label>DIM_N <small>1–12</small><input id="n" type="number" min="1" max="16" value="8" /></label>
            <label>DIM_K <small>1–16</small><input id="k" type="number" min="1" max="20" value="16" /></label>
            <label>PREC<select id="prec"><option value="0">0 · INT8</option><option value="1">1 · INT16</option><option value="2">2 · FP16</option><option value="3">3 · BF16</option><option value="4">4 · INT4</option></select></label>
            <label>A_BASE<input id="a" class="mono" value="0x8000" /></label>
            <label>B_BASE<input id="b" class="mono" value="0x8400" /></label>
            <label>C_BASE<input id="c" class="mono" value="0x8800" /></label>
          </div>
          <div id="warn" class="warn mono" aria-live="polite"></div>
          <div class="btns">
            <button class="btn btn-primary" id="start" type="button">Write CTRL.START</button>
            <button class="btn btn-ghost" id="reroll" type="button">New data</button>
            <button class="btn btn-ghost" id="reset" type="button">Reset</button>
          </div>
          <p class="hint">Try: START four times quickly to fill the queue, then once more. Or set DIM_K to 20.</p>
        </div>

        <!-- 2. Registers + status -->
        <div class="card regs">
          <h3>2 · Register file <span class="mono base" id="baseLbl"></span></h3>
          <div class="leds mono">
            <span class="led" id="ledBusy"><i></i>BUSY</span>
            <span class="led" id="ledDone"><i></i>DONE</span>
            <span class="led err" id="ledErr"><i></i>ERROR</span>
            <span class="q">Queue <span id="qdots"></span></span>
          </div>
          <table class="mono">
            <thead><tr><th>Offset</th><th>Register</th><th>Value</th></tr></thead>
            <tbody id="regRows"></tbody>
          </table>
          <h4>Bus log</h4>
          <ol class="log mono" id="log"></ol>
        </div>
      </div>

      <!-- 3. Memory -->
      <div class="card mem">
        <h3>3 · Memory <span class="sub">little-endian, row-major, packed per 32-bit word</span></h3>
        <div class="memgrid" id="mem"></div>
      </div>

      <!-- 4. Code -->
      <div class="card code">
        <div class="code-h">
          <h3>4 · The same thing in C</h3>
          <div class="tabs mono" role="tablist">
            <button type="button" role="tab" data-tab="drv" aria-selected="true">Driver API</button>
            <button type="button" role="tab" data-tab="raw" aria-selected="false">Raw registers</button>
            <button type="button" id="copy">Copy</button>
          </div>
        </div>
        <pre class="mono"><code id="codeOut"></code></pre>
        <p class="src mono">API from <a href={`${site.hw.soc}/blob/main/c930/sw/c930_npu_driver.h`}>c930/sw/c930_npu_driver.h</a>. Registers and limits from <a href={`${site.hw.soc}/tree/main/c930/rtl`}>c930/rtl</a> (SoC build: MAX_M 8, MAX_N 12, MAX_K 16, queue depth 4). <a href="/docs/hardware/npu">NPU register docs →</a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { NPU, PREC, REGS, dimsOk, operandBytes, rng, randomMatrix, gemm, pack, packC, hex, hex4, type Prec } from '../../lib/npu';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const num = (id: string) => Number(($(id) as HTMLInputElement).value);
  const parseAddr = (id: string) => { const v = ($(id) as HTMLInputElement).value.trim(); const n = /^0x/i.test(v) ? parseInt(v, 16) : Number(v); return Number.isFinite(n) ? n >>> 0 : NaN; };
  const esc = (t: string) => t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));

  type Cmd = { m: number; n: number; k: number; a: number; b: number; c: number; prec: Prec; A: number[][]; B: number[][] };
  let seed = 930;
  let busy = false, done = false, error = false;
  let queue: Cmd[] = [];
  let mem: Record<'A' | 'B' | 'C', { addr: number; words: number[]; prec: Prec; dims: string } | null> = { A: null, B: null, C: null };
  const regs: Record<string, number> = {};
  let changed = new Set<string>();
  let tab: 'drv' | 'raw' = 'drv';

  function log(msg: string, kind = '') {
    const li = document.createElement('li'); li.className = kind; li.innerHTML = msg;
    $('log').prepend(li);
    while ($('log').children.length > 40) $('log').lastChild!.remove();
  }
  function current(): Cmd {
    const m = num('m'), n = num('n'), k = num('k'), prec = Number(($('prec') as HTMLSelectElement).value) as Prec;
    const r = rng(seed);
    const A = randomMatrix(Math.max(1, Math.min(m, 12)), Math.max(1, Math.min(k, 20)), prec, r);
    const B = randomMatrix(Math.max(1, Math.min(k, 20)), Math.max(1, Math.min(n, 16)), prec, r);
    return { m, n, k, a: parseAddr('a'), b: parseAddr('b'), c: parseAddr('c'), prec, A, B };
  }
  function problems(c: Cmd) {
    const p: { msg: string; driver?: boolean; hw?: boolean }[] = [];
    if (!dimsOk(c.m, c.n, c.k)) p.push({ msg: `Dimensions outside the SoC build's limits (M 1–${NPU.MAX_M}, N 1–${NPU.MAX_N}, K 1–${NPU.MAX_K}): the driver returns -2; written directly, START sets ERROR.`, hw: true });
    for (const [nm, v] of [['A_BASE', c.a], ['B_BASE', c.b], ['C_BASE', c.c]] as const) {
      if (Number.isNaN(v)) p.push({ msg: `${nm} isn't a number.`, driver: true });
      else if (v & 3) p.push({ msg: `${nm} ${hex(v, 4)} isn't word-aligned: npu_drv_submit returns -2 before touching a register.`, driver: true });
    }
    const sz = { A: operandBytes(c.m * c.k, c.prec), B: operandBytes(c.k * c.n, c.prec), C: c.m * c.n * 4 };
    const spans = [['A', c.a, sz.A], ['B', c.b, sz.B], ['C', c.c, sz.C]] as const;
    for (const [nm, v, s] of spans) if (!Number.isNaN(v) && (v < NPU.DDR_LO || v + s - 1 > NPU.DDR_HI)) p.push({ msg: `${nm} (${hex(v, 4)}–${hex(v + s - 1, 4)}) runs outside the 60 KB DDR stub (0x1000–0xFFFF).` });
    for (let i = 0; i < 3; i++) for (let j = i + 1; j < 3; j++) {
      const [n1, a1, s1] = spans[i], [n2, a2, s2] = spans[j];
      if (a1 < a2 + s2 && a2 < a1 + s1) p.push({ msg: `${n1} and ${n2} overlap in memory.` });
    }
    return p;
  }

  function writeRegs(c: Cmd) {
    const vals: Record<string, number> = { DIM_M: c.m, DIM_N: c.n, DIM_K: c.k, A_BASE: c.a, B_BASE: c.b, C_BASE: c.c, PREC: c.prec };
    for (const [k, v] of Object.entries(vals)) if (regs[k] !== v) { regs[k] = v; changed.add(k); }
  }
  function status() { return (busy ? 1 : 0) | (done ? 2 : 0) | (error ? 4 : 0); }

  function render() {
    const c = current();
    const npu = Number(($('npu') as HTMLSelectElement).value);
    $('baseLbl').textContent = hex(NPU.BASE[npu]);
    // warnings
    const pr = problems(c);
    $('warn').innerHTML = pr.map((p) => `<p>⚠ ${esc(p.msg)}</p>`).join('');
    // register table
    regs.STATUS = status(); regs.CTRL = 0; regs.QUEUE_STAT = queue.length | (queue.length >= NPU.QUEUE_DEPTH ? 0x10 : 0); regs.QUEUE_MAX = NPU.QUEUE_DEPTH;
    $('regRows').innerHTML = REGS.map((r) => {
      const v = regs[r.name] ?? 0;
      return `<tr class="${changed.has(r.name) ? 'chg' : ''}" title="${esc(r.desc)}"><td>+${hex(r.off, 2)}</td><td>${r.name}<span class="acc">${r.acc}</span></td><td>${Number.isNaN(v) ? '—' : hex4(v)}</td></tr>`;
    }).join('');
    changed = new Set();
    // status
    $('ledBusy').classList.toggle('on', busy); $('ledDone').classList.toggle('on', done); $('ledErr').classList.toggle('on', error);
    $('qdots').innerHTML = Array.from({ length: NPU.QUEUE_DEPTH }, (_, i) => `<i class="${i < queue.length ? 'on' : ''}"></i>`).join('');
    renderMem(); renderCode(c);
  }

  function renderMem() {
    $('mem').innerHTML = (['A', 'B', 'C'] as const).map((nm) => {
      const r = mem[nm];
      if (!r) return `<div class="blk"><h4>${nm}</h4><p class="empty">${nm === 'C' ? 'Written when a GEMM completes.' : 'Loaded with the next START.'}</p></div>`;
      const rows = r.words.slice(0, 48).map((w, i) => `<tr><td>${hex(r.addr + i * 4, 4)}</td><td>${hex(w)}</td></tr>`).join('');
      const more = r.words.length > 48 ? `<tr><td colspan="2">… ${r.words.length - 48} more words</td></tr>` : '';
      return `<div class="blk"><h4>${nm} <span>${r.dims} · ${PREC[r.prec].name}${nm === 'C' ? (PREC[r.prec].int ? ' → INT32' : ' → FP32') : ` · ${PREC[r.prec].perWord}/word`}</span></h4><table>${rows}${more}</table></div>`;
    }).join('');
  }

  function renderCode(c: Cmd) {
    const npu = Number(($('npu') as HTMLSelectElement).value);
    const base = npu ? 'NPU1_BASE' : 'NPU0_BASE';
    const precName = `NPU_PREC_${PREC[c.prec].name}`;
    const h = (v: number) => (Number.isNaN(v) ? '/* invalid */ 0' : hex(v, 4) + 'u');
    const drv = `#include "c930_npu_driver.h"

int run_gemm(void) {
    npu_drv_gemm_t g = {
        .dim_m = ${c.m}, .dim_n = ${c.n}, .dim_k = ${c.k},
        .a_base = ${h(c.a)},   // A: ${c.m}×${c.k} ${PREC[c.prec].name}, row-major, packed
        .b_base = ${h(c.b)},   // B: ${c.k}×${c.n} ${PREC[c.prec].name}, row-major, packed
        .c_base = ${h(c.c)},   // C: ${c.m}×${c.n} ${PREC[c.prec].int ? 'INT32' : 'FP32'}, one word each
        .prec   = ${precName},
    };
    npu_drv_mmio(${base});

    int rc = ${npu ? 'npu_drv_submit_at(NPU1_BASE, &g)' : 'npu_drv_submit(&g)'};
    if (rc == -1) return -1;   // queue full: START would be dropped
    if (rc == -2) return -2;   // dims out of range or unaligned base

    if (npu_drv_wait_done(NPU_DRV_TIMEOUT_FOREVER)) return -3;
    if (npu_drv_error()) return -4;

    npu_drv_stats_t st;
    npu_drv_get_stats(&st);    // st.core_cycles, st.ops, st.stalls, st.dma_last
    return 0;
}`;
    const raw = `#include <stdint.h>
#define REG(off) (*(volatile uint32_t *)(${hex(NPU.BASE[npu])}u + (off)))

void run_gemm_raw(void) {
    while (REG(0x38) & 0x10) ;            // QUEUE_STAT.full: START would be dropped
    REG(0x08) = ${c.m};                     // DIM_M
    REG(0x0c) = ${c.n};                     // DIM_N
    REG(0x10) = ${c.k};                    // DIM_K
    REG(0x14) = ${h(c.a)};               // A_BASE
    REG(0x18) = ${h(c.b)};               // B_BASE
    REG(0x1c) = ${h(c.c)};               // C_BASE
    REG(0x20) = ${c.prec};                     // PREC: ${PREC[c.prec].name}
    REG(0x00) = 1;                     // CTRL.START: snapshot + queue, clears DONE/ERROR

    while (!(REG(0x04) & 0x2)) ;          // wait for DONE (latched)
    while (REG(0x04) & 0x1) ;             // then BUSY clear: C writeback drained
    if (REG(0x04) & 0x4) { /* ERROR */ }
}`;
    $('codeOut').textContent = tab === 'drv' ? drv : raw;
  }

  // ---- the engine: one command at a time, from the queue ----
  let running = false;
  async function pump() {
    if (running) return; running = true;
    while (queue.length) {
      const cmd = queue[0];
      await sleep(250);
      if (!dimsOk(cmd.m, cmd.n, cmd.k)) {
        queue.shift(); error = true; busy = false;
        log(`dispatch: dims ${cmd.m}×${cmd.n}×${cmd.k} fail the DMA's check → <b class="e">ERROR=1</b>, nothing runs`, 'e');
        render(); continue;
      }
      busy = true; render();
      log(`dispatch ${cmd.m}×${cmd.n}×${cmd.k} ${PREC[cmd.prec].name}: DMA loads A and B → <b>BUSY=1</b>`);
      mem.A = { addr: cmd.a, words: pack(cmd.A.slice(0, cmd.m).map((r) => r.slice(0, cmd.k)), cmd.prec), prec: cmd.prec, dims: `${cmd.m}×${cmd.k}` };
      mem.B = { addr: cmd.b, words: pack(cmd.B.slice(0, cmd.k).map((r) => r.slice(0, cmd.n)), cmd.prec), prec: cmd.prec, dims: `${cmd.k}×${cmd.n}` };
      render();
      await sleep(1100);
      const C = gemm(cmd.A.slice(0, cmd.m).map((r) => r.slice(0, cmd.k)), cmd.B.slice(0, cmd.k).map((r) => r.slice(0, cmd.n)), cmd.prec);
      mem.C = { addr: cmd.c, words: packC(C, cmd.prec), prec: cmd.prec, dims: `${cmd.m}×${cmd.n}` };
      done = true; queue.shift();
      log(`GEMM complete: C written to ${hex(cmd.c, 4)} → <b class="ok">DONE=1</b> (latched)`, 'ok');
      render();
      await sleep(200);
      busy = false;
      log(queue.length ? `BUSY=0 for the dispatch bubble; ${queue.length} still queued` : 'C writeback drained → <b>BUSY=0</b>');
      render();
    }
    running = false;
  }
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  $('start').addEventListener('click', () => {
    const c = current();
    for (const [nm, v] of [['DIM_M', c.m], ['DIM_N', c.n], ['DIM_K', c.k], ['A_BASE', c.a], ['B_BASE', c.b], ['C_BASE', c.c], ['PREC', c.prec]] as const)
      if (regs[nm] !== v) log(`write ${nm} = ${Number.isNaN(v) ? '?' : nm.endsWith('BASE') ? hex(v, 4) : v}`);
    writeRegs(c);
    if (queue.length >= NPU.QUEUE_DEPTH) {
      log(`write CTRL.START → <b class="e">dropped</b>: queue full (the 1-cycle pulse is not deferred)`, 'e');
      render(); return;
    }
    done = false; error = false;
    queue.push(c);
    log(`write CTRL.START → snapshot queued (${queue.length}/${NPU.QUEUE_DEPTH}); DONE and ERROR cleared`);
    render(); pump();
  });
  $('reroll').addEventListener('click', () => { seed = (seed * 1103515245 + 12345) >>> 0; log('new A and B data'); render(); });
  $('reset').addEventListener('click', () => { busy = done = error = false; queue = []; mem = { A: null, B: null, C: null }; for (const k in regs) delete regs[k]; $('log').innerHTML = ''; log('reset'); render(); });
  for (const id of ['npu', 'm', 'n', 'k', 'prec', 'a', 'b', 'c']) $(id).addEventListener('input', render);
  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
    tab = b.dataset.tab as 'drv' | 'raw';
    document.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    render();
  }));
  $('copy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText($('codeOut').textContent || ''); $('copy').textContent = 'Copied ✓'; } catch { $('copy').textContent = 'Select & copy'; }
    setTimeout(() => ($('copy').textContent = 'Copy'), 1600);
  });
  log('ready: registers at reset');
  render();
</script>

<style>
  .model { font-size: .78rem; margin: 0 0 20px; line-height: 1.6; }
  .model code { color: var(--gw-white); }
  .st { display: inline-block; font: 500 .62rem/1 var(--gw-font-mono); letter-spacing: .05em; text-transform: uppercase; padding: 4px 7px; border-radius: 3px; border: 1px solid #b9a3ff66; color: #b9a3ff; margin-right: 6px; }
  .pg { display: grid; gap: 16px; grid-template-columns: 1fr; margin-bottom: 16px; }
  @media (min-width: 980px) { .pg { grid-template-columns: 1fr 1fr; } }
  .pg > * { min-width: 0; }
  h3 { font-size: 1.05rem; margin-bottom: 16px; }
  h3 .base, h3 .sub { font-size: .75rem; color: var(--gw-steel); font-weight: 400; margin-left: 8px; }
  .fields { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 560px) { .fields { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .fields label { display: grid; gap: 6px; font: 500 .7rem/1.2 var(--gw-font-mono); letter-spacing: .06em; color: var(--gw-steel); }
  .fields label:first-child { grid-column: 1 / -1; }
  .fields small { font-size: .65rem; letter-spacing: 0; color: #5c6678; margin-left: 4px; }
  .fields input, .fields select {
    min-width: 0; font: 400 .9rem/1.3 var(--gw-font-mono); color: var(--gw-white); background: var(--gw-bg);
    border: 1px solid var(--gw-line-strong); border-radius: var(--gw-radius); padding: 8px 10px;
  }
  .fields input:focus, .fields select:focus { outline: none; border-color: var(--gw-teal); }
  .warn { font-size: .76rem; color: #ffb020; margin-top: 12px; }
  .warn :global(p) { margin: 0 0 6px; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .btns .btn { cursor: pointer; }
  .hint { font-size: .82rem; margin: 14px 0 0; }
  .leds { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; font-size: .72rem; margin-bottom: 14px; }
  .led { display: inline-flex; align-items: center; gap: 6px; color: var(--gw-steel); }
  .led i { width: 10px; height: 10px; border-radius: 50%; background: var(--gw-line-strong); transition: background .15s, box-shadow .15s; }
  .led.on { color: var(--gw-white); }
  .led.on i { background: var(--gw-green); box-shadow: 0 0 8px var(--gw-green); }
  .led.err.on i { background: #ff5c7a; box-shadow: 0 0 8px #ff5c7a; }
  .q { margin-left: auto; color: var(--gw-steel); display: inline-flex; align-items: center; gap: 6px; }
  .q :global(i) { display: inline-block; width: 12px; height: 12px; border: 1px solid var(--gw-line-strong); border-radius: 2px; }
  .q :global(i.on) { background: var(--gw-teal); border-color: var(--gw-teal); }
  table { width: 100%; border-collapse: collapse; font-size: .76rem; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--gw-line); }
  th { color: var(--gw-steel); font-weight: 500; font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; }
  td { color: var(--gw-white); }
  .regs :global(td .acc) { color: #5c6678; font-size: .65rem; margin-left: 6px; }
  .regs :global(tr.chg td) { background: #0f1d1d; color: var(--gw-teal); transition: background .4s; }
  h4 { font: 500 .68rem/1 var(--gw-font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--gw-steel); margin: 18px 0 8px; }
  .log { list-style: none; padding: 0; margin: 0; max-height: 180px; overflow-y: auto; font-size: .72rem; display: grid; gap: 4px; }
  .log :global(li) { color: var(--gw-steel); }
  .log :global(li:first-child) { color: var(--gw-white); }
  .log :global(b.e), .log :global(li.e b) { color: #ff5c7a; font-weight: 500; }
  .log :global(b.ok) { color: var(--gw-green); font-weight: 500; }
  .mem { margin-bottom: 16px; }
  .memgrid { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .memgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .memgrid :global(.blk h4) { margin-top: 0; color: var(--gw-teal); }
  .memgrid :global(.blk h4 span) { color: var(--gw-steel); text-transform: none; letter-spacing: 0; margin-left: 6px; }
  .memgrid :global(table) { font-family: var(--gw-font-mono); font-size: .72rem; }
  .memgrid :global(td:first-child) { color: #5c6678; width: 1%; white-space: nowrap; }
  .memgrid :global(.empty) { font-size: .8rem; margin: 0; }
  .code-h { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 12px; }
  .code-h h3 { margin: 0; }
  .tabs { display: flex; gap: 6px; font-size: .72rem; }
  .tabs button { font: inherit; color: var(--gw-steel); background: transparent; border: 1px solid var(--gw-line-strong); border-radius: 4px; padding: 4px 10px; cursor: pointer; }
  .tabs button[aria-selected='true'] { color: var(--gw-bg); background: var(--gw-teal); border-color: var(--gw-teal); }
  #copy { color: var(--gw-teal); }
  pre { margin: 0; padding: 18px; background: #05060a; border: 1px solid var(--gw-line); border-radius: var(--gw-radius); font-size: .76rem; line-height: 1.6; color: var(--gw-white); overflow-x: auto; }
  .src { font-size: .72rem; margin: 12px 0 0; }
  code { font-family: var(--gw-font-mono); }
</style>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../site';
// TODO: replace with real founder bios and photos.
const team = [
  { name: 'Founder Name', role: 'CEO & Co-founder', bio: 'Ex-[Company] silicon lead. 15 years shipping SoCs. PhD, [University].' },
  { name: 'Founder Name', role: 'CTO & Co-founder', bio: 'Former photonics researcher at [Lab]. Author of [N] papers on electro-optic compute.' },
  { name: 'Founder Name', role: 'Head of Software', bio: 'Built compiler backends at [Company]. LLVM contributor.' },
];
const roles = [
  { title: 'RTL Design Engineer', team: 'Hardware', loc: 'Remote / Hybrid' },
  { title: 'Design Verification Engineer (cocotb / UVM)', team: 'Hardware', loc: 'Remote / Hybrid' },
  { title: 'Compiler Architect (LLVM)', team: 'Software', loc: 'Remote / Hybrid' },
  { title: 'Photonic Integration Engineer', team: 'Hardware', loc: 'On-site' },
  { title: 'Developer Relations, Academic Programs', team: 'Community', loc: 'Remote' },
];
---
<Base title="Company" description="The team behind Gridworkz, a fabless chip design company building open silicon.">
  <PageHead eyebrow="Company" title="A fabless team building open silicon.">
    Gridworkz designs chips and partners with foundries to make them. We're engineers from silicon, photonics and compiler teams who think hardware research should be open.
  </PageHead>
  <section style="padding-top:0">
    <div class="wrap">
      <span class="eyebrow">Leadership <span class="tbc">PLACEHOLDER</span></span>
      <div class="bento">
        {team.map((p) => (
          <article class="card person">
            <div class="avatar" aria-hidden="true"></div>
            <h3>{p.name}</h3>
            <span class="tag">{p.role}</span>
            <p>{p.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section-line" id="careers">
    <div class="wrap">
      <span class="eyebrow">Careers</span>
      <h2>Open roles</h2>
      <ul class="roles">
        {roles.map((r) => (
          <li>
            <a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(r.title)}`}>
              <span class="rt">{r.title}</span>
              <span class="mono meta">{r.team} · {r.loc}</span>
              <span class="arrow">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .avatar {
    width: 64px; height: 64px; border-radius: 8px; margin-bottom: 18px;
    background: repeating-linear-gradient(90deg, var(--gw-line-strong) 0 1px, transparent 1px 8px),
                repeating-linear-gradient(0deg, var(--gw-line-strong) 0 1px, var(--gw-surface) 1px 8px);
    border: 1px solid var(--gw-teal);
  }
  .person p { margin-top: 12px; }
  .roles { list-style: none; padding: 0; margin: 24px 0 0; border-top: 1px solid var(--gw-line); }
  .roles a { display: grid; grid-template-columns: 1fr auto auto; gap: 16px; align-items: center; padding: 20px 4px; border-bottom: 1px solid var(--gw-line); }
  .roles a:hover { text-decoration: none; background: #0f1d1d; }
  .rt { color: var(--gw-white); font-weight: 500; }
  .meta { font-size: .78rem; color: var(--gw-steel); }
  .arrow { color: var(--gw-teal); }
  @media (max-width: 640px) { .roles a { grid-template-columns: 1fr auto; } .meta { grid-column: 1; } .arrow { grid-row: 1 / span 2; grid-column: 2; } }
</style>

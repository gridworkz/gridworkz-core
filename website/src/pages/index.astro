---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Architecture from '../components/Architecture.astro';
import LabForm from '../components/LabForm.astro';
import RepoStats from '../components/RepoStats.astro';
import { site } from '../site';
---
<Base>
  <!-- 1. Hook -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">[ Gridworkz Hardware Core {site.version} ]</span>
        <h1>Open Silicon.<br />No NDAs.<br /><span class="hl">No Licensing Fees.</span></h1>
        <p class="lede">
          Gridworkz is building the Linux of chip design: synthesizable RISC-V64 cores, dual NPUs and a
          co-packaged photonic tensor accelerator, all open source on GitHub. Built for university labs and research teams.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={site.repo}>Clone the repository ↗</a>
          <a class="btn btn-ghost" href="/manifesto">Read the manifesto</a>
        </div>
        <ul class="chips mono">
          <li>Apache 2.0</li><li>Verilator</li><li>OpenLane</li><li>LLVM</li><li>PyTorch</li>
        </ul>
      </div>
      <!-- 2. Proof -->
      <Terminal />
    </div>
  </section>

  <!-- Live GitHub stats (off until site.showRepoStats is true) -->
  <RepoStats />

  <!-- Zero-cost pitch -->
  <section class="section-line">
    <div class="wrap">
      <span class="eyebrow">Zero-cost deployment</span>
      <h2>From git clone to waveform<br />in 10 minutes.</h2>
      <p class="lede">No proprietary licenses. No enterprise contracts. Everything runs on open-source toolchains, on your laptop.</p>
      <div class="bento" style="margin-top:40px">
        <article class="card">
          <span class="tag">Simulate instantly</span>
          <h3>Sim-ready infrastructure</h3>
          <p>Every core ships with Verilator and Icarus Verilog testbenches. Trace data through the photonic accelerator without a physical board.</p>
        </article>
        <article class="card">
          <span class="tag">Compile effortlessly</span>
          <h3>Native compiler support</h3>
          <p>Drop C/C++ or PyTorch models into the pre-configured LLVM / RISC-V toolchain and watch the NPUs split the work.</p>
        </article>
        <article class="card">
          <span class="tag">Synthesize out of the box</span>
          <h3>FPGA deployment</h3>
          <p>Verified constraint files and bitstream scripts for standard FPGA dev boards, mirroring the ASIC layout.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. Architecture -->
  <section class="section-line" id="architecture">
    <div class="wrap">
      <span class="eyebrow">Architecture</span>
      <h2>Every block, exposed.</h2>
      <p class="lede">Select a block to see the Verilog behind it, its register map and its pinout.</p>
      <div style="margin-top:40px"><Architecture /></div>
    </div>
  </section>

  <!-- The open stack -->
  <section class="section-line">
    <div class="wrap">
      <span class="eyebrow">The open stack</span>
      <h2>Layered like an operating system.</h2>
      <div class="stack">
        <article class="card layer">
          <span class="tag">Layer 0 · Base</span>
          <h3>Unhindered bare-metal compute.</h3>
          <p>A transparent quad-core 64-bit RISC-V block. Modify extensions, design your own instructions and compile with standard LLVM on verified RTL.</p>
        </article>
        <article class="card layer">
          <span class="tag">Layer 1 · Acceleration</span>
          <h3>Accessible tensor workloads.</h3>
          <p>Open NPU and GPU designs that expose every register: build custom quantization schemes, study sparsity and change compiler backends.</p>
        </article>
        <article class="card layer">
          <span class="tag">Layer 2 · Frontier</span>
          <h3>Co-packaged light-speed compute.</h3>
          <p>The G100 drives an integrated photonic tensor chiplet for electro-optic co-design and laser-driven analog matrix multiplication.</p>
        </article>
        <article class="card layer sdk">
          <span class="tag">Layer 3 · Software</span>
          <h3>Programmable hardware. Zero assembly required.</h3>
          <p>Write parallel C++ with the open, LLVM-backed GCA SDK. If you can write CUDA or HIP, you can write kernels for Gridworkz.</p>
          <pre class="snippet"><code><span class="k">__global__</span> <span class="t">void</span> vectorAdd(<span class="t">float</span>* A, <span class="t">float</span>* B, <span class="t">float</span>* C, <span class="t">int</span> N) {'{'}
  <span class="t">int</span> i = gca_blockIdx_x * gca_blockDim_x + gca_threadIdx_x;
  <span class="k">if</span> (i &lt; N) C[i] = A[i] + B[i];
{'}'}</code></pre>
          <a class="mono" href="/docs/sdk/quickstart">GCA quickstart →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Docs teaser -->
  <section class="section-line">
    <div class="wrap docs-teaser">
      <div>
        <span class="eyebrow">Documentation</span>
        <h2>Read the registers before you write the grant.</h2>
        <p class="lede">RTL architecture, register maps, pinouts, toolchain setup and errata, all public and versioned with the code.</p>
        <div class="btn-row"><a class="btn btn-ghost" href="/docs">Open the docs →</a></div>
      </div>
      <div class="regmap card mono" aria-label="Register map excerpt">
        <div class="rm-h"><span>NPU0 · CTRL</span><span>0x4000_0000</span></div>
        <table>
          <thead><tr><th>Bits</th><th>Field</th><th>Access</th></tr></thead>
          <tbody>
            <tr><td>[0]</td><td>ENABLE</td><td>RW</td></tr>
            <tr><td>[3:1]</td><td>DTYPE</td><td>RW</td></tr>
            <tr><td>[7:4]</td><td>SPARSITY_MODE</td><td>RW</td></tr>
            <tr><td>[15:8]</td><td>TILE_DIM</td><td>RW</td></tr>
            <tr><td>[31]</td><td>BUSY</td><td>RO</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5. Lead capture -->
  <section class="section-line" id="request">
    <div class="wrap lead">
      <div>
        <span class="eyebrow">For labs</span>
        <h2>Request an evaluation board for your lab.</h2>
        <p>Ready to move from simulation to physical hardware? We supply FPGA evaluation kits to qualified university labs and public research teams.</p>
        <p><a href="/labs">Allocation details and grant datasheet →</a></p>
      </div>
      <LabForm />
    </div>
  </section>

  <section class="section-line cta">
    <div class="wrap">
      <h2>Stop buying black boxes.<br /><span class="hl">Start building the future of hardware.</span></h2>
      <p class="lede">Fork the codebase, simulate with Verilator or OpenLane, or order a board to test your ideas on real silicon.</p>
      <div class="btn-row"><a class="btn btn-primary" href={site.repo}>Fork on GitHub ↗</a></div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 72px 0 96px; }
  .hero-grid { display: grid; gap: 48px; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1.05fr 1fr; } }
  .hero-grid > * { min-width: 0; }
  .hl { color: var(--gw-teal); }
  .chips { list-style: none; padding: 0; margin: 32px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { font-size: .72rem; padding: 5px 10px; border: 1px solid var(--gw-line-strong); border-radius: 99px; }
  .stack { display: grid; gap: 16px; margin-top: 40px; grid-template-columns: 1fr; }
  @media (min-width: 820px) { .stack { grid-template-columns: repeat(3, 1fr); } .sdk { grid-column: 1 / -1; } }
  .layer { border-left: 2px solid var(--gw-teal); }
  .sdk { display: grid; gap: 4px 40px; }
  @media (min-width: 820px) { .sdk { grid-template-columns: 1fr 1.2fr; } .sdk .snippet { grid-column: 2; grid-row: 1 / span 4; align-self: center; } }
  .snippet {
    margin: 12px 0; padding: 16px; background: #05060a; border: 1px solid var(--gw-line); border-radius: var(--gw-radius);
    font-size: .78rem; line-height: 1.7; color: var(--gw-white); overflow-x: auto;
  }
  .k { color: var(--gw-teal); } .t { color: #7aa2ff; }
  .docs-teaser, .lead { display: grid; gap: 40px; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 900px) { .docs-teaser { grid-template-columns: 1fr 1fr; } .lead { grid-template-columns: .8fr 1.2fr; align-items: start; } }
  .regmap { padding: 0; overflow: hidden; font-size: .8rem; }
  .rm-h { display: flex; justify-content: space-between; padding: 12px 18px; border-bottom: 1px solid var(--gw-line); color: var(--gw-teal); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 9px 18px; border-bottom: 1px solid var(--gw-line); }
  th { color: var(--gw-steel); font-weight: 500; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  td { color: var(--gw-white); }
  tr:last-child td { border-bottom: 0; }
  .cta { text-align: center; padding: 120px 0; }
  .cta .lede { margin: 0 auto; }
  .cta .btn-row { justify-content: center; }
</style>
